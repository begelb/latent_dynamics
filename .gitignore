tmp.py

# Replay outputs from rerunning render/metrics/diagnose against a
# read_only config. These are derived, machine-specific, and meant to be
# regenerated on demand - do not track them.
/replay/

# Notebook playground + scratch renders. The notebooks (recompute_morse /
# retrain) and the box_scale sweep write here; all regenerable on demand.
/output/notebooks/
/output/box_scale_sweep/
/notebooks/rendered/

# ---------------------------------------------------------------------------
# Heavy run artefacts under data/ and output/: local only.
#
# data/ and output/ are working directories - every dataset, checkpoint,
# box list and render in them is regenerable from a config. What the paper
# actually ships lives elsewhere and stays tracked:
#   replay_sources/  the fixed models replayed for the paper figures
#   paper_figures/   the staged paper-ready PDFs/PNGs
# Only the small provenance records under data/ and output/ stay tracked
# (config.yaml, metrics.json, run_manifest.json, training_summary.json,
# morse_graph.dot, mg_params_log.txt).
# ---------------------------------------------------------------------------

# Datasets and cached arrays
/data/**/*.csv
/data/**/*.pkl
/data/**/*.npy
/data/**/*.npz
/output/**/*.csv
/output/**/*.pkl
/output/**/*.npy
/output/**/*.npz

# CMGDB box lists (one line per box; the largest exceed GitHub's 100 MB limit)
/output/**/morse_sets
/output/**/morse_sets2

# Model checkpoints - retrain from the config
/data/**/*.pt
/output/**/*.pt

# Rendered figures - paper-going copies live in paper_figures/
/data/**/*.pdf
/data/**/*.png
/data/**/*.gif
/output/**/*.pdf
/output/**/*.png
/output/**/*.gif

# Per-epoch training histories; training_summary.json is kept
/output/**/*history.json
